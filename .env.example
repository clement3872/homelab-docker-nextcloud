# -------------------------------------------------------
# Nextcloud — environment variables
# Copy to .env and fill in the values (run generate-secrets.sh)
# -------------------------------------------------------

# ── Database ─────────────────────────────────────────────
PG_PASS=        # required — generate with: openssl rand -base64 36
PG_USER=nextcloud
PG_DB=nextcloud

# ── Nextcloud image ──────────────────────────────────────
# Check https://hub.docker.com/_/nextcloud/tags
# Pin a specific patch to avoid surprise upgrades.
NEXTCLOUD_TAG=35.0.2-apache

# ── Nextcloud core ───────────────────────────────────────
NEXTCLOUD_DOMAIN=cloud.yourdomain.com
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=    # required — generate with: openssl rand -base64 24

# ── Networking ───────────────────────────────────────────
# Port Caddy will hit on localhost (Authentik is on 9000)
NEXTCLOUD_PORT=9001

# ── Authentik (SSO) ──────────────────────────────────────
# Used by the app container to resolve auth.yourdomain.com to localhost
# (hairpin fix — Docker internal DNS won't resolve external domains back).
AUTH_DOMAIN=auth.yourdomain.com

# ── PHP tuning ───────────────────────────────────────────
# 512M is a reasonable floor on the RPi 5; bump if you hit memory errors.
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=2G

# ── Whiteboard ───────────────────────────────────────────
# Check https://github.com/nextcloud-releases/whiteboard/releases
WHITEBOARD_TAG=latest
WHITEBOARD_SECRET=    # required — generated by generate-secrets.sh
WHITEBOARD_PORT=3002

# ── Talk (Spreed) ────────────────────────────────────────
# coturn runs on the VPS (internet-facing), not on the RPi.
# See VPS coturn setup in the homelab docs.
# This secret is shared between coturn (/etc/turnserver.conf) and
# Nextcloud (Settings → Talk → TURN servers).
TURN_SERVER=turn.yourdomain.com
TURN_PORT=3478
TURN_SECRET=    # required — generate with: openssl rand -hex 32
